# Leave unset to use the built-in SQLite fallback:
# sqlite:///./voice_lead_tracker.db
#
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/voice_lead_tracker
DATABASE_URL=sqlite:///./voice_lead_tracker.db

# OmniDimension outbound call dispatch:
OMNIDIM_API_KEY=your-omnidimension-api-key
OMNIDIM_AGENT_ID=247494
OMNIDIM_FROM_NUMBER_ID=6728

# Unipile WhatsApp follow-up messages:
SENDER_PHONE_NUMBER=""
UNIPILE_DSN=your-unipile-dsn
UNIPILE_API_KEY=your-unipile-api-key
UNIPILE_ACCOUNT_ID=your-unipile-account-id
RESUME_FILE_PATH=/path/to/resume.pdf

# Callback scheduling:
GROQ_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
GOOGLE_SERVICE_ACCOUNT_FILE=""
GOOGLE_CALENDAR_ID=""
service_account_id=""
google_calendar_api_key=""
